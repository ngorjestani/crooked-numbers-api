{
  "AllowedHosts": "*",
  "MlbApi": {
    "BaseUrl": "https://statsapi.mlb.com/api/",
    "TeamsCacheMinutes": 60,
    "TeamCacheMinutes": 30,
    "RosterCacheMinutes": 15,
    "StatsCacheMinutes": 10,
    "ScheduleCacheMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
